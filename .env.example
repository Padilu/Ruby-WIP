# =================================================================
# Ruby Assistant - Environment Variables Template
# =================================================================
# Catatan: Ruby Assistant secara bawaan menyimpan API Key & konfigurasi
# melalui UI Settings modal ke penyimpanan aman (tauri-plugin-store / localStorage).
# File .env ini bersifat opsional untuk konfigurasi Vite atau pengujian lokal.

# Vite Development Server Port
VITE_DEV_SERVER_PORT=1420

# Optional: Default Provider / API Keys (Jika ingin di-inject via build)
# VITE_OPENAI_API_KEY=
# VITE_ANTHROPIC_API_KEY=
# VITE_GEMINI_API_KEY=
# VITE_OLLAMA_BASE_URL=http://localhost:11434
